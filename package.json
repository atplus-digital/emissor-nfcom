{
	"name": "emissor-nfcom",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"build": "bun build src/index.ts --outdir dist --target bun",
		"start": "bun run src/index.ts",
		"test": "vitest run",
		"lint": "biome lint .",
		"typecheck": "tsc --noEmit --types bun",
		"format:md": "bunx prettier --write \"**/*.{md,mdx}\" --no-error-on-unmatched-pattern --cache",
		"format:sh": "bunx prettier --write \"**/*.sh\" --plugin=prettier-plugin-sh --no-error-on-unmatched-pattern --cache",
		"format": "biome format --write . && bun format:md && bun format:sh",
		"knip": "knip",
		"prepare": "husky",
		"spellcheck": "cspell .",
		"secrets:check": "sh scripts/gitleaks-check",
		"lint-staged": "lint-staged",
		"generate:types": "bun ./scripts/nocobase/src/index.ts"
	},
	"dependencies": {},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@cspell/dict-pt-br": "^2.4.2",
		"@t3-oss/env-core": "^0.13.11",
		"@types/bun": "^1.3.14",
		"cspell": "^10.0.1",
		"dotenv": "^17.4.2",
		"husky": "^9.1.7",
		"knip": "^6.32.2",
		"lint-staged": "^17.3.0",
		"listr2": "^11.0.0",
		"prettier": "^3.9.6",
		"prettier-plugin-sh": "^0.19.0",
		"test-staged": "^1.1.11",
		"tsc-files": "^1.1.4",
		"vitest": "^4.1.10",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	}
}
