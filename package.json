{
	"name": "emissor-nfcom",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "docker compose up",
		"dev:native": "bun --watch src/index.ts",
		"build": "bun build src/index.ts --outdir dist --target bun",
		"viewer:install": "cd viewer && bun install",
		"viewer:dev": "cd viewer && bun run dev",
		"start": "bun run src/index.ts",
		"test": "bun test --isolate",
		"test:watch": "bun test --isolate --watch",
		"test:coverage": "bun test --isolate --coverage",
		"lint": "biome lint .",
		"typecheck": "tsc --noEmit --types bun",
		"format:md": "bunx prettier --write \"**/*.{md,mdx}\" --no-error-on-unmatched-pattern --cache",
		"format:sh": "bunx prettier --write \"**/*.sh\" --plugin=prettier-plugin-sh --no-error-on-unmatched-pattern --cache",
		"format": "biome format --write . && bun format:md && bun format:sh",
		"knip": "knip",
		"prepare": "husky",
		"spellcheck": "cspell .",
		"secrets:check": "sh scripts/gitleaks-check",
		"lint-staged": "lint-staged",
		"generate:types": "bun ./scripts/nocobase/src/index.ts"
	},
	"dependencies": {
		"@t3-oss/env-core": "^0.13.11",
		"bullmq": "^6.1.1",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.2",
		"ioredis": "^6.0.0",
		"pino": "^10.3.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@cspell/dict-pt-br": "^2.4.2",
		"@libsql/client": "^0.17.4",
		"@types/bun": "^1.3.14",
		"cspell": "^10.0.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"husky": "^9.1.7",
		"knip": "^6.32.2",
		"lint-staged": "^17.3.0",
		"listr2": "^11.0.0",
		"prettier": "^3.9.6",
		"prettier-plugin-sh": "^0.19.0",
		"pino-pretty": "^11.2.2",
		"tsc-files": "^1.1.4"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	}
}
