{
	"compilerOptions": {
		// Environment setup & latest features
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,
		"types": ["bun"],

		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		// Some stricter flags (disabled by default)
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false,

		// Path aliases do gerador de types (scripts/nocobase)
		"paths": {
			"#/*": ["./src/*"],
			"@generators/*": ["./scripts/nocobase/src/*"],
			"@shared/types": ["./scripts/nocobase/types.ts"],
			"@shared/*": ["./scripts/nocobase/src/*"]
		}
	},
	"exclude": [
		"node_modules",
		// Testes rodam via bun test (transpilação), não são typecheckados
		"**/*.test.ts",
		"**/*.spec.ts",
		// Frontend de visualização (viewer/) tem tsconfig próprio (lib DOM) e
		// valida isolado (`bunx tsc --noEmit` em viewer/). Excluído do typecheck
		// da raiz — não faz parte do bundle do emissor (frontend separado).
		"viewer"
	]
}
