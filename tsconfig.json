{
	"compilerOptions": {
		// Environment setup & latest features
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,
		"types": ["bun"],

		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		// Some stricter flags (disabled by default)
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false,

		// Path aliases (monorepo, ADR-0011): `#/` aponta para o src do backend;
		// `@emissor/db/*` para o pacote de workspace (a resolução primária é o
		// symlink de workspace + exports do package.json — o alias é robustez
		// para typecheck). Restantes: gerador de types (scripts/nocobase).
		"paths": {
			"#/*": ["./apps/backend/src/*"],
			"@emissor/db/*": ["./packages/db/src/*"],
			"@generators/*": ["./scripts/nocobase/src/*"],
			"@pipelines/*": ["./scripts/nocobase/pipelines/*"]
		}
	},
	"exclude": [
		"node_modules",
		// Testes rodam via bun test (transpilação), não são typecheckados
		"**/*.test.ts",
		"**/*.spec.ts",
		// Frontend de visualização (apps/viewer) tem tsconfig próprio (lib DOM) e
		// valida isolado (`bunx tsc --noEmit` em apps/viewer). Excluído do
		// typecheck da raiz — não faz parte do bundle do emissor (frontend separado).
		"apps/viewer"
	]
}
