# ---------- App ----------
PORT="3000"
APP_PORT="3333"
VIEWER_PORT="3332"

EMISSOR_API_KEY="" # X-API-Key da API interna (CONVENTIONS.md · Autorização)

# Portas publicadas no HOST no dev via compose (docker-compose.dev.yaml).
# App (Hono) — fallback 3333. Viewer (Vite) — fallback 3332. O compose usa
# ${VAR:-default}, então funcionam mesmo sem redefinir aqui; basta descomentar
# p/ overrides. No compose a porta INTERNA do container é fixa (app 3000 /
# viewer 5173) — só a porta de host muda. `dev:native` (sem compose) usa PORT
# acima direto no host.
#APP_PORT="3333"
#VIEWER_PORT="3332"

# Caminho do SQLite de coordenação (idempotency keys, outbox, lease — ADR-0003).
# Deve apontar para volume persistente em produção.
DATABASE_URL="./data/emissor.db"

# ---------- Redis / BullMQ (ADR-0002) ----------
REDIS_URL="redis://localhost:6379"

# ---------- Atacado / NocoBase (ADR-0004) ----------
NOCOBASE_API_KEY=""
NOCOBASE_API_URL="https://atacado.atplus.com.br/api"
# Opcional: app NocoBase (header X-App). Necessário quando a API exige multi-app.
NOCOBASE_APP="a_atacado"
# Id do autenticador NocoBase (header X-Authenticator do auth:signIn/check).
# Default "password" — ajustar se o CRM usar outro tipo de autenticação.
NOCOBASE_AUTHENTICATOR="password"
# Secret do cookie de sessão do painel de visualização (`painel_sess`,
# HMAC-SHA256). **Opcional de propósito**: ausente = painel desligado (o server
# não monta as rotas /painel) — não quebra o deploy existente. Defina para ativar
# o login/visualização de faturas/notas.
PAINEL_COOKIE_SECRET=""

# Path absoluto do `dist` do viewer buildado (Vite). Opcional: ausente → o
# backend serve só a API (sem o painel web). Em produção o Dockerfile copia o
# build p/ /app/viewer e define VIEWER_DIST=/app/viewer automaticamente — só
# descomente aqui p/ override. Em dev use o vite dev-server (bun run viewer:dev)
# — não setar esta var localmente.
#VIEWER_DIST="/app/viewer"

# ---------- Asaas (ADR-0004) ----------
ASAAS_API_KEY=""
# Base do Asaas SEM o sufixo /v3 — o cliente (asaas.client) anexa /v3/ em cada
# path. Se incluir /v3 aqui, vira /v3/v3/... (404).
# Sandbox p/ dev/homologação: https://api-sandbox.asaas.com
ASAAS_API_URL="https://api.asaas.com"

# ---------- NFCom gateway (ADR-0001) ----------
# Provedor dispõe de ambiente de homologação — confirmar a URL de hom com o provedor.
NFCOM_API_URL="https://api.nfcom.com.br"
NFCOM_LOGIN=""
NFCOM_SENHA=""

# ---------- Webhook de saída (SPEC-0001 passo 6) ----------
# Sem URL configurada, eventos não são empurrados (caso 14) — só GET.
WEBHOOK_URL=""
WEBHOOK_SECRET="" # HMAC do corpo no header X-Webhook-Signature

# ---------- Rate-limit por gateway (req/s, ADR-0002) ----------
RATE_LIMIT_ASAAS="5"
RATE_LIMIT_NFCOM="2"
RATE_LIMIT_ATACADO="10"

# ---------- Defaults fiscais (SPEC-0002; revisar com contador) ----------
FISCAL_CFOP_DEFAULT="6307"
# Obrigatório (z.string().min(1), ADR-0005). Código de classe de serviço (cClass)
# default da NFCom. Sem default na env — cada ambiente precisa de um valor real.
# ⚠️ VALOR ABAIXO É PLACEHOLDER: confirmar o cClass correto com o contador antes
# de produzir; boot falha se a env ficar vazia.
FISCAL_CCLASS_DEFAULT="0100201"
FISCAL_ICMS_ALIQUOTA="0"
# Opcional: placeholder p/ destinatário isento (parceiro com f_ie="ISENTO").
# Só necessário se o gateway NFCom rejeitar a emissão sem `rgie` — nesse caso,
# envie um valor numérico aceito pelo SEFAZ/provedor. Vazio = `rgie` omitido.
# ⚠️ ABAIXO COMENTADO = DESLIGADO por padrão; confirmar com contador antes de usar.
#FISCAL_IE_ISENTO=""
